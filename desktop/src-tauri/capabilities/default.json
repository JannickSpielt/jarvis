{
  "identifier": "default",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:11434/*"
        },
        {
          "url": "http://localhost:11434/*"
        }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}