{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis",
  "version": "1.14.0",
  "identifier": "io.github.jannickspielt.jarvis",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node -e \"require('fs').copyFileSync('../index.html','dist/app.html')\""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Jarvis", "width": 1100, "height": 760, "minWidth": 380, "minHeight": 520, "backgroundColor": "#070504" }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Productivity",
    "shortDescription": "Persönlicher KI-Assistent",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
