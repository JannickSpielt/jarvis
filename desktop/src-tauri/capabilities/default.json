{
  "identifier": "default",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:*/*"
        },
        {
          "url": "http://localhost:*/*"
        },
        {
          "url": "https://api.mage.space/*"
        }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}